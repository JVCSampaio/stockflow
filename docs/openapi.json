{
  "openapi": "3.1.0",
  "info": {
    "title": "StockFlow API",
    "description": "Estoque com saldo e histórico transacionais. Projeto local com dados sintéticos.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "List Products",
        "operationId": "list_products_api_products_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120,
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "low_stock",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Low Stock"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Product",
        "operationId": "create_product_api_products_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{product_id}": {
      "get": {
        "summary": "Product Detail",
        "operationId": "product_detail_api_products__product_id__get",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/movements": {
      "post": {
        "summary": "Create Movement",
        "operationId": "create_movement_api_movements_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovementCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovementView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List Movements",
        "operationId": "list_movements_api_movements_get",
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Product Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovementList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_api_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsView"
                }
              }
            }
          }
        }
      }
    },
    "/api/export/{report}.csv": {
      "get": {
        "summary": "Export",
        "operationId": "export_api_export__report__csv_get",
        "parameters": [
          {
            "name": "report",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "products",
                "movements"
              ],
              "type": "string",
              "title": "Report"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricsView": {
        "properties": {
          "products": {
            "type": "integer",
            "title": "Products"
          },
          "units": {
            "type": "integer",
            "title": "Units"
          },
          "value_cents": {
            "type": "integer",
            "title": "Value Cents"
          },
          "low_stock": {
            "type": "integer",
            "title": "Low Stock"
          },
          "empty": {
            "type": "integer",
            "title": "Empty"
          }
        },
        "type": "object",
        "required": [
          "products",
          "units",
          "value_cents",
          "low_stock",
          "empty"
        ],
        "title": "MetricsView"
      },
      "MovementCreate": {
        "properties": {
          "product_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Product Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ],
            "title": "Kind"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Note"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid4",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_id",
          "kind",
          "quantity",
          "note",
          "idempotency_key"
        ],
        "title": "MovementCreate"
      },
      "MovementList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MovementWithProduct"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "MovementList"
      },
      "MovementView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ],
            "title": "Kind"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_cost_cents": {
            "type": "integer",
            "title": "Unit Cost Cents"
          },
          "balance_after": {
            "type": "integer",
            "title": "Balance After"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product_id",
          "kind",
          "quantity",
          "unit_cost_cents",
          "balance_after",
          "note",
          "idempotency_key",
          "created_at"
        ],
        "title": "MovementView"
      },
      "MovementWithProduct": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ],
            "title": "Kind"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_cost_cents": {
            "type": "integer",
            "title": "Unit Cost Cents"
          },
          "balance_after": {
            "type": "integer",
            "title": "Balance After"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "product_id",
          "kind",
          "quantity",
          "unit_cost_cents",
          "balance_after",
          "note",
          "idempotency_key",
          "created_at",
          "sku",
          "name"
        ],
        "title": "MovementWithProduct"
      },
      "ProductCreate": {
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{2,24}$",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "Hardware",
              "Periféricos",
              "Infraestrutura",
              "Papelaria"
            ],
            "title": "Category"
          },
          "unit_cost_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 0.0,
            "title": "Unit Cost Cents"
          },
          "reorder_point": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Reorder Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sku",
          "name",
          "category",
          "unit_cost_cents",
          "reorder_point"
        ],
        "title": "ProductCreate"
      },
      "ProductList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductView"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
