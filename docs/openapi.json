      },
      "ProductView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "sku": {
            "type": "string",
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "unit_cost_cents": {
            "type": "integer",
            "title": "Unit Cost Cents"
          },
          "reorder_point": {
            "type": "integer",
            "title": "Reorder Point"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "low_stock": {
            "type": "boolean",
            "title": "Low Stock"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sku",
          "name",
          "category",
          "unit_cost_cents",
          "reorder_point",
          "quantity",
          "created_at",
          "low_stock"
        ],
        "title": "ProductView"
      },
